<.clickthrough_shell active={@active} query={@query} signed_in={@signed_in}>
  <div class="page-head">
    <div>
      <h1>Calendar</h1>
      <p>Your relevant huddlz in chronological order.</p>
    </div>
  </div>

  <div class="cal-toolbar">
    <div class="cal-nav">
      <button class="cal-nav-btn" aria-label="Previous month">‹</button>
      <button class="cal-nav-today">Today</button>
      <button class="cal-nav-btn" aria-label="Next month">›</button>
    </div>

    <div class="cal-period-title">
      <span class="cal-period-name">May 2026</span>
      <span class="cal-period-count">(1 huddl)</span>
    </div>

    <div class="cal-view-tabs">
      <button class="scope-tab">Today</button>
      <button class="scope-tab">Week</button>
      <button class="scope-tab is-active">Month</button>
    </div>
  </div>

  <div
    id="calendar-month-grid"
    class="cal-month-grid"
    role="grid"
    aria-label="Month calendar for May 2026"
  >
    <div role="row" class="cal-month-row">
      <span
        :for={day <- ~w(Sun Mon Tue Wed Thu Fri Sat)}
        role="columnheader"
        class="cal-month-weekday"
      >
        {day}
      </span>
    </div>
    <div :for={week <- 0..5} role="row" class="cal-month-row">
      <a
        :for={weekday <- 0..6}
        href="#"
        role="gridcell"
        class={[
          "cal-month-day",
          week == 0 && weekday < 5 && "is-outside-month",
          week == 2 && weekday == 2 && "is-today is-selected"
        ]}
        aria-current={if week == 2 && weekday == 2, do: "date"}
      >
        <time>{rem(week * 7 + weekday + 26, 31) + 1}</time>
      </a>
    </div>
  </div>

  <section class="cal-month-selection" aria-labelledby="calendar-month-selection-title">
    <h2 id="calendar-month-selection-title">Tuesday, May 12, 2026</h2>
    <div class="grid">
      <a class="card" href="/dev/design/clickthrough/huddl">
        <div class="card-cover gradient-2">
          <div class="date-stamp"><span class="m">MAY</span><span class="d">12</span></div>
          <span class="card-tag online">Online</span>
        </div>
        <div class="card-body">
          <span class="card-group">Austin Elixir</span>
          <h3 class="card-title">LiveView deep dive</h3>
          <div class="card-meta"><span>6:30 PM</span></div>
        </div>
        <div class="card-foot"><span class="pill cyan">Going</span></div>
      </a>
    </div>
  </section>
</.clickthrough_shell>
